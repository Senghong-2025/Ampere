{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --dotenv .env.local",
    "db:publish": "node database/publish-db.mjs",
    "db:publish:local": "node database/publish-db.mjs --env .env.local",
    "db:publish:prod": "node database/publish-db.mjs --env .env",
    "prod": "nuxt dev --dotenv .env",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "build:worker": "nuxi build --preset=cloudflare_module",
    "preview:worker": "npm run build:worker && wrangler dev --config wrangler.worker.toml",
    "deploy:worker": "npm run build:worker && wrangler deploy --config wrangler.worker.toml",
    "build:prod": "npm run build:worker",
    "deploy:prod": "npm run deploy:worker"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@element-plus/nuxt": "^1.1.4",
    "@neondatabase/serverless": "^1.1.0",
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/icon": "^2.0.0",
    "@tailwindcss/vite": "^4.1.12",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "element-plus": "^2.10.7",
    "eslint": "^9.33.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "nuxt": "^4.0.3",
    "swiper": "^12.2.0",
    "tailwindcss": "^4.1.12",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "wrangler": "^4.86.0"
  }
}
